# Allow the logged-in desktop user to control Alienware lighting via hidraw.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="187c", ATTRS{idProduct}=="0550", TAG+="uaccess", MODE="0660", GROUP="wheel"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0d62", ATTRS{idProduct}=="3740", TAG+="uaccess", MODE="0660", GROUP="wheel"
SUBSYSTEM=="usb", ATTR{idVendor}=="187c", ATTR{idProduct}=="0550", TAG+="uaccess", MODE="0660", GROUP="wheel"
SUBSYSTEM=="usb", ATTR{idVendor}=="0d62", ATTR{idProduct}=="3740", TAG+="uaccess", MODE="0660", GROUP="wheel"
